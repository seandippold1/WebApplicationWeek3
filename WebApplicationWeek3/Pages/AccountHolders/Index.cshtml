@page
@model WebApplicationWeek3.Pages.AccountHolders.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AccountHolder[0].firstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountHolder[0].lastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountHolder[0].dateofBirth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountHolder[0].socialsecurityNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountHolder[0].phoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountHolder[0].BankAccounts)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.AccountHolder) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.firstName)
            </td>
            <td>
                @Html.DisplayFor(model => item.lastName)
            </td>
            <td>
                @Html.DisplayFor(model => item.dateofBirth)
            </td>
            <td>
                @Html.DisplayFor(model => item.socialsecurityNumber)
            </td>
            <td>
                @Html.DisplayFor(model => item.phoneNumber)
            </td>
            <td>
                @Html.DisplayFor(model => item.BankAccounts)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.AccountHolderId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.AccountHolderId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.AccountHolderId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
